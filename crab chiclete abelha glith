-- CARREGAMENTO DA BARRA ROXA (ETAPAS EQUILIBRADAS)
---------------------------------------------------------
task.spawn(function()
	task.wait(0.5)

	-- fillTime: tempo que leva deslizando (2 segundos)
	-- pauseTime: pausa entre cada etapa (3 segundos)
	local steps = {
		{target = 0.25, fillTime = 2.0, pauseTime = 3.0},
		{target = 0.55, fillTime = 2.0, pauseTime = 3.0},
		{target = 0.80, fillTime = 2.0, pauseTime = 3.0},
		{target = 1.00, fillTime = 1.8, pauseTime = 1.0}
	}

	for _, step in ipairs(steps) do
		local tween = TweenService:Create(
			barFill,
			TweenInfo.new(step.fillTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{Size = UDim2.new(step.target, 0, 1, 0)}
		)
		tween:Play()
		tween.Completed:Wait()

		if step.pauseTime > 0 then
			task.wait(step.pauseTime)
		end
	end

	loadingFrame.Visible = false
	adminFrame.Visible = true
	toggleButton.Visible = true
end)
