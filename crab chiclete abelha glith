local function processSpawn()
	local rawName = spawnerInput.Text
	local cleanName = rawName:lower():gsub("^%s*(.-)%s*$", "%1")

	local rawMut = normalInput.Text
	local cleanMut = rawMut:lower():gsub("^%s*(.-)%s*$", "%1")
	if cleanMut == "" then cleanMut = "normal" end

	local traitsVal = (traitsInput.Text == "" or traitsInput.Text == "Traits (0)") and "none" or traitsInput.Text

	if rawName == "" or rawName == "Brainrot name or alias" then
		spawnerSub.Text = "Made By LarpOnTop"
		spawnerSub.TextColor3 = Color3.fromRGB(130, 135, 145)
		return
	end

	-- Valida o Brainrot
	if not validBrainrots[cleanName] then
		spawnerSub.Text = "❌ Brainrot (" .. rawName .. ") Not Found"
		spawnerSub.TextColor3 = Color3.fromRGB(240, 70, 70)
		return
	end

	-- Valida a Mutação
	if not validMutations[cleanMut] then
		spawnerSub.Text = "❌ Mutation (" .. rawMut .. ") Not Found"
		spawnerSub.TextColor3 = Color3.fromRGB(240, 70, 70)
		return
	end

	-- Sucesso ao clicar em SPAWN
	local prefix = isLoopOn and "✅ Loop ON | " or "✅ "
	spawnerSub.Text = prefix .. "SpawnBrainrot [" .. rawName .. " | " .. rawMut .. " | " .. traitsVal .. "]"
	spawnerSub.TextColor3 = Color3.fromRGB(130, 225, 90)
end

